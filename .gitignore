# ============================================================
#  J.A.R.V.I.S  —  .gitignore
# ============================================================

# Virtual environment
venv/
.venv/
env/

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc

# Private configuration — NEVER committed
config_private.py
secrets.py
.env
*.env
*.key
*.token
credentials.json
token.json
service_account.json

# Vosk model and voice weights (large binaries)
assets/voice_model/
assets/piper/
voice/models/jarvis/*.onnx
voice/cache/
memory/backups/
*.zip
*.tar.gz

# Logs
logs/
*.log

# IDE / OS
.vscode/
.idea/
*.DS_Store
Thumbs.db
desktop.ini

# Build / dist
build/
dist/
*.egg-info/
*.egg

# Test artifacts
.pytest_cache/
.coverage
htmlcov/

# Jupyter
*.ipynb_checkpoints/

# Byte-compiled
*.so

